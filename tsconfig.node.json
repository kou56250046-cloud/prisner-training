{
  "compilerOptions": {
    "target": "ES2022",
    // crypto.ts をビルドスクリプトと共有しているため、WebCrypto の型（CryptoKey /
    // BufferSource）が要る。Node 24 は globalThis.crypto を持つので実行時は問題ない
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,

    "baseUrl": ".",
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["vite.config.ts", "scripts/**/*.ts"]
}
